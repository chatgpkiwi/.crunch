# Local crunch state may be edited by users, but the committed copy remains
# available to every clone as the repository's baseline database.
database/crunch.db

# Child projects are independent repositories with their own remotes.
/projects/*
!/projects/.gitkeep

# Python bytecode generated locally while running the tools.
__pycache__/
*.py[cod]

# Keep the directory in the repository, but ignore generated log contents.
/logs/*
!/logs/.gitkeep

.aider*
